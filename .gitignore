# Environment
.env
.venv/
__pycache__/
*.pyc

# Telethon session (contains live auth; never commit)
*.session
*.session-journal

# Local data: ignore contents at every depth, including new artifact folders.
# Only the layout guide and empty-directory placeholders belong in Git.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/README.md
*.db
*.db-wal
*.db-shm
*.db.bak-*

# Editors / OS
.vscode/
.DS_Store

# Test/lint caches
.pytest_cache/
.ruff_cache/
