# Telethon (MTProto userbot) — from https://my.telegram.org
# Set these to your host uid/gid before building Docker so the non-root
# container can write the bind-mounted ./data directory (`id -u`, `id -g`).
PUID=1000
PGID=1000

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Path to the persisted Telethon session file (mounted volume in Docker later)
TELEGRAM_SESSION_PATH=data/session.session

# Source channel: the existing camera system's channel you are a member of but do not control.
# Use the numeric chat ID or @username the account can resolve.
SOURCE_CHANNEL=

# Bot API (python-telegram-bot) — from @BotFather. Used to post to the channel you control.
TELEGRAM_BOT_TOKEN=
ALERT_CHANNEL_ID=

# ntfy (self-hosted). Leave NTFY_TOKEN blank if the instance is unauthenticated
# (e.g. reachable only over the Docker network). From a container,
# localhost points back to that same container; use the ntfy service hostname
# or a host-reachable URL instead.
NTFY_BASE_URL=http://localhost:80
NTFY_TOPIC=nature-ridge-perimeter
NTFY_PRIORITY=urgent
NTFY_TOKEN=

# SQLite database path
DB_PATH=data/perimeter_watch.db

# Live watcher. The 300s sibling window covers all but 6 of 8,274 measured
# Initial/follow-up pairs in the current corpus; 99.9% arrived within 286s.
EVENT_WAIT_SECONDS=300
WATCHER_POLL_SECONDS=5
WATCHER_HEARTBEAT_PATH=data/live/watcher.heartbeat
LIVE_MEDIA_DIR=data/live/clips
# Keep false on analysis/development machines. Enable only on storage-constrained servers.
MEDIA_RETENTION_ENABLED=false
MEDIA_RETENTION_INTERVAL_SECONDS=3600
DELIVERY_RETRY_BASE_SECONDS=30
DELIVERY_RETRY_MAX_SECONDS=900

# Camera operating window (local time, 24h). Outside this window, silence is expected, not a fault.
OPERATING_WINDOW_START=18:00
OPERATING_WINDOW_END=06:00

# Telegram user IDs allowed to use the query bot (Phase 5), comma-separated.
BOT_TRUSTEE_IDS=
BOT_SECURITY_IDS=

# Optional contact directory shown under Bot menu -> Info. Use international
# phone format (for example +27111234567) so Telegram clients can make it tappable.
SECURITY_COMPANY_NAME=
SECURITY_COMPANY_PHONE=
CONTROL_ROOM_PHONE=
ARMED_RESPONSE_PHONE=
